@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar bg-dark">
        <nav class="flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/messages">
                    <i class="bi bi-chat-left-text"></i> Messages
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/appointments">
                    <i class="bi bi-calendar-event"></i> Appointments
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/devices">
                    <i class="bi bi-laptop"></i> Refurbished Devices
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/invoices">
                    <i class="bi bi-receipt"></i> Invoices
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/payments">
                    <i class="bi bi-credit-card"></i> Payments
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/users">
                    <i class="bi bi-people"></i> Users
                </NavLink>
            </div>
        </nav>
    </div>

    <main>
        <div class="top-row px-4">
            <div class="ms-auto">
                <span class="me-3">Admin User</span>
                <button class="btn btn-link">Logout</button>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .sidebar {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        padding-top: 20px;
    }

    .sidebar .nav-item {
        font-size: 0.9rem;
        padding-bottom: 0.5rem;
    }

    .sidebar .nav-item:first-of-type {
        padding-top: 1rem;
    }

    .sidebar .nav-item:last-of-type {
        padding-bottom: 1rem;
    }

    .sidebar .nav-link {
        color: #d7d7d7;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 4px;
        margin: 0 8px;
    }

    .sidebar .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .sidebar .nav-link.active {
        background-color: rgba(255, 255, 255, 0.25);
        color: white;
    }

    .top-row {
        background-color: #f7f7f7;
        border-bottom: 1px solid #d6d5d5;
        justify-content: flex-end;
        height: 3.5rem;
        display: flex;
        align-items: center;
    }

    main {
        margin-left: 250px;
    }

    .content {
        padding-top: 1.1rem;
    }

    article {
        min-height: calc(100vh - 3.5rem);
        background-color: #f8f9fa;
    }
</style>
