@page "/diensten"

<PageTitle>Onze Diensten - DuurzaamDigitaal</PageTitle>

<div class="hero py-5">
    <div class="container">
        <h1 class="mb-3">Onze Diensten</h1>
        <p class="lead mb-4">Duurzame en toegankelijke IT-oplossingen voor iedereen</p>
        <NavLink class="btn btn-light" href="afspraak">
            Direct een afspraak maken
        </NavLink>
    </div>
</div>

<div class="container mt-4">
    <!-- Computer Repair Section -->
    <div class="row mb-5">
        <div class="col-md-6">
            <h2>Computer Reparatie</h2>
            <p class="lead">Professionele reparatie op basis van no-cure-no-pay</p>
            <div class="card">
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>Gratis diagnose van problemen</li>
                        <li>Laptop en desktop reparaties</li>
                        <li>Scherm en toetsenbord vervanging</li>
                        <li>Hardware upgrades en onderhoud</li>
                        <li>Gebruik van duurzame onderdelen</li>
                    </ul>

                    <NavLink class="btn btn-success mt-3" href="reparatie">
                        Meer over reparatie
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <img src="/api/placeholder/600/400" alt="Computer Repair" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- Software Support Section -->
    <div class="row mb-5 flex-md-row-reverse">
        <div class="col-md-6">
            <h2>Software Support</h2>
            <p class="lead">Persoonlijke ondersteuning en training</p>
            <div class="card">
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>Computerlessen voor senioren</li>
                        <li>Virus en malware verwijdering</li>
                        <li>Software installatie en updates</li>
                        <li>Email en internet ondersteuning</li>
                        <li>Persoonlijke hulp aan huis</li>
                    </ul>
                    <NavLink class="btn btn-success mt-3" href="software">
                        Meer over software support
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <img src="/api/placeholder/600/400" alt="Software Support" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- Data Recovery Section -->
    <div class="row mb-5">
        <div class="col-md-6">
            <h2>Data Recovery</h2>
            <p class="lead">Herstel van verloren bestanden en data</p>
            <div class="card">
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>Herstel van gewiste bestanden</li>
                        <li>Reparatie beschadigde harde schijven</li>
                        <li>Recovery van USB sticks en SD kaarten</li>
                        <li>Back-up en data overdracht</li>
                        <li>Veilige dataverwijdering</li>
                    </ul>
                    <NavLink class="btn btn-success mt-3" href="datarecovery">
                        Meer over data recovery
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <img src="/api/placeholder/600/400" alt="Data Recovery" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- Refurbished Hardware Section -->
    <div class="row mb-5 flex-md-row-reverse">
        <div class="col-md-6">
            <h2>Refurbished Hardware</h2>
            <p class="lead">Duurzaam opgeknapte computers en laptops</p>
            <div class="card">
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>Gecertificeerde refurbished systemen</li>
                        <li>6 maanden garantie</li>
                        <li>Duurzaam en betaalbaar</li>
                        <li>Volledig getest en geüpgraded</li>
                        <li>Inclusief software installatie</li>
                    </ul>
                    <NavLink class="btn btn-success mt-3" href="refurbished">
                        Bekijk refurbished aanbod
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <img src="/api/placeholder/600/400" alt="Refurbished Hardware" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- E-waste Recycling Section -->
    <div class="row mb-5">
        <div class="col-md-6">
            <h2>E-waste Recycling</h2>
            <p class="lead">Verantwoorde verwerking van elektronisch afval</p>
            <div class="card">
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li>Gratis inname van oude apparatuur</li>
                        <li>Milieuvriendelijke verwerking</li>
                        <li>Hergebruik van componenten</li>
                        <li>Veilige datavernietiging</li>
                        <li>Certificaat van verwerking</li>
                    </ul>
                    <NavLink class="btn btn-success mt-3" href="recycling">
                        Meer over recycling
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <img src="/api/placeholder/600/400" alt="E-waste Recycling" class="img-fluid rounded shadow" />
        </div>
    </div>

    <!-- Pricing and Contact Section -->
    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">Tarieven</h3>
                    <p>We hanteren transparante prijzen zonder verborgen kosten:</p>
                    <ul class="list-unstyled">
                        <li>Diagnose: Gratis</li>
                        <li>Reparatie: €45 per uur</li>
                        <li>Software support: €40 per uur</li>
                        <li>Training: €35 per uur</li>
                    </ul>
                    <NavLink class="btn btn-outline-success mt-3" href="prijzen">
                        Bekijk alle tarieven
                    </NavLink>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">Direct Contact</h3>
                    <p>Heeft u vragen of wilt u een afspraak maken?</p>
                    <div class="mb-3">
                        <strong>Telefoon:</strong><br />
                        <a href="tel:[Your Phone]">[Your Phone]</a>
                    </div>
                    <div class="mb-3">
                        <strong>Email:</strong><br />
                        <a href="mailto:[Your Email]">[Your Email]</a>
                    </div>
                    <NavLink class="btn btn-outline-success mt-3" href="afspraak">
                        Afspraak Maken
                    </NavLink>
                    <NavLink class="btn btn-outline-success mt-3" href="contact">
                        Contact Opnemen
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</div>