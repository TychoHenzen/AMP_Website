@inherits LayoutComponentBase
@inject NidoSuave.Services.TaglineService TaglineService
@implements IDisposable

<div class="page">
    <NavMenu />

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="container-narrow">
            <a class="brand" href="">Nido <span>Suave</span></a>
            <p><a href="contact">Maak een afspraak</a></p>
            <p class="site-footer__small">© @DateTime.Now.Year Nido Suave — Alle rechten voorbehouden.</p>
        </div>
    </footer>
</div>

@code {
    protected override void OnInitialized() => TaglineService.OnChange += StateHasChanged;
    public void Dispose() => TaglineService.OnChange -= StateHasChanged;
}
