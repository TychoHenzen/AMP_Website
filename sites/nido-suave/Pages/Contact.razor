@page "/contact"

<PageTitle>Contact — Nido Suave</PageTitle>

<section class="block">
    <div class="container-narrow" style="text-align:center;">
        <p class="eyebrow">Even contact</p>
        <h1 class="section-title">Maak een afspraak</h1>
        <p style="max-width:560px; margin:0 auto 2.5rem; color:var(--ink-soft);">
            Heb je een vraag of wil je een afspraak maken? Stuur gerust een bericht.
            Je hoeft niks uit te leggen — vertel gewoon wat je zoekt.
        </p>

        <div class="cards" style="max-width:560px; margin:0 auto;">
            <div class="card-soft">
                <h3>E-mail</h3>
                <p><a href="mailto:info@nidosuave.nl">info@nidosuave.nl</a></p>
            </div>
            <div class="card-soft">
                <h3>Telefoon / WhatsApp</h3>
                <p><a href="tel:+31000000000">+31 (0)0 00 00 00 00</a></p>
            </div>
        </div>

        <p style="margin-top:2rem; color:var(--ink-soft); font-style:italic;">
            Contactgegevens zijn nog voorlopig en worden binnenkort ingevuld.
        </p>
    </div>
</section>
