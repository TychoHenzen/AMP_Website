@page "/skills"

<PageTitle>Tycho Henzen - Skills</PageTitle>

<div class="container mt-5">
    <h1>Skills & Interests</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="terminal-section mb-4">
                <div class="terminal-header">
                    <span class="terminal-title">languages.sh</span>
                    <div class="terminal-buttons ms-auto">
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                    </div>
                </div>
                <div class="terminal-body">
                    <p class="comment-line">// Programming Languages</p>
                    @foreach (var skill in languages)
                    {
                        <div class="terminal-skill-bar">
                            <span class="terminal-skill-name">@skill.Name</span>
                            <span class="terminal-skill-blocks">@(new string('█', skill.Level / 5))@(new string('░', 20 - skill.Level / 5))</span>
                            <span class="terminal-skill-pct">@skill.Level%</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="terminal-section mb-4">
                <div class="terminal-header">
                    <span class="terminal-title">frameworks.sh</span>
                    <div class="terminal-buttons ms-auto">
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                    </div>
                </div>
                <div class="terminal-body">
                    <p class="comment-line">// Frameworks & Tools</p>
                    @foreach (var skill in frameworks)
                    {
                        <div class="terminal-skill-bar">
                            <span class="terminal-skill-name">@skill.Name</span>
                            <span class="terminal-skill-blocks">@(new string('█', skill.Level / 5))@(new string('░', 20 - skill.Level / 5))</span>
                            <span class="terminal-skill-pct">@skill.Level%</span>
                        </div>
                    }
                </div>
            </div>

            <div class="terminal-section mb-4">
                <div class="terminal-header">
                    <span class="terminal-title">specialized.sh</span>
                    <div class="terminal-buttons ms-auto">
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                        <span class="terminal-button"></span>
                    </div>
                </div>
                <div class="terminal-body">
                    <p class="comment-line">// Specialized Skills</p>
                    @foreach (var skill in specialized)
                    {
                        <div class="terminal-skill-bar">
                            <span class="terminal-skill-name">@skill.Name</span>
                            <span class="terminal-skill-blocks">@(new string('█', skill.Level / 5))@(new string('░', 20 - skill.Level / 5))</span>
                            <span class="terminal-skill-pct">@skill.Level%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h2>Soft Skills</h2>
            <ul class="list-group">
                <li class="list-group-item"><i class="fa-solid fa-brain me-2" style="color: #60a5fa;"></i>Analytical thinking</li>
                <li class="list-group-item"><i class="fa-solid fa-puzzle-piece me-2" style="color: #60a5fa;"></i>Problem solving</li>
                <li class="list-group-item"><i class="fa-solid fa-magnifying-glass me-2" style="color: #60a5fa;"></i>Attention to detail</li>
                <li class="list-group-item"><i class="fa-solid fa-book-open me-2" style="color: #60a5fa;"></i>Continuous learning</li>
                <li class="list-group-item"><i class="fa-solid fa-people-group me-2" style="color: #60a5fa;"></i>Collaboration</li>
                <li class="list-group-item"><i class="fa-solid fa-arrows-rotate me-2" style="color: #60a5fa;"></i>Adaptability</li>
                <li class="list-group-item"><i class="fa-solid fa-comments me-2" style="color: #60a5fa;"></i>Communication</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h2>Hobbies & Interests</h2>
            <ul class="list-group">
                <li class="list-group-item"><i class="fa-solid fa-gamepad me-2" style="color: #60a5fa;"></i>Game Development</li>
                <li class="list-group-item"><i class="fa-solid fa-wand-magic-sparkles me-2" style="color: #60a5fa;"></i>Shader Programming</li>
                <li class="list-group-item"><i class="fa-solid fa-robot me-2" style="color: #60a5fa;"></i>Artificial Intelligence</li>
                <li class="list-group-item"><i class="fa-solid fa-dna me-2" style="color: #60a5fa;"></i>Biology</li>
                <li class="list-group-item"><i class="fa-solid fa-flask me-2" style="color: #60a5fa;"></i>Chemistry</li>
                <li class="list-group-item"><i class="fa-solid fa-desktop me-2" style="color: #60a5fa;"></i>Demoscene</li>
                <li class="list-group-item"><i class="fa-solid fa-dice-d20 me-2" style="color: #60a5fa;"></i>Dungeons & Dragons</li>
                <li class="list-group-item"><i class="fa-solid fa-hand-fist me-2" style="color: #60a5fa;"></i>Kyokushin Karate</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private record SkillItem(string Name, int Level);

    private List<SkillItem> languages = new()
    {
        new("C#", 95),
        new("C++", 80),
        new("Java", 70),
        new("Python", 65),
        new("HTML/CSS", 55),
        new("SQL", 40),
        new("PHP", 30),
        new("TypeScript", 25)
    };

    private List<SkillItem> frameworks = new()
    {
        new("Unity", 85),
        new("Git", 80),
        new("Blazor", 70),
        new("WPF", 65),
        new("Jenkins", 60)
    };

    private List<SkillItem> specialized = new()
    {
        new("Network (UDP/TCP)", 85),
        new("Perf Optimization", 80),
        new("Algorithm Dev", 75),
        new("TDD", 70)
    };
}
