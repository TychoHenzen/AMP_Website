@page "/"
@inject ProjectDataService DataService
@inject NavigationManager Nav
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<h1 class="mb-3">Portfolio Projects</h1>

<button class="btn btn-success mb-3" @onclick="CreateNew">+ New Project</button>

@if (_message != null)
{
    <div class="alert alert-info alert-dismissible">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:40px">#</th>
            <th>Title</th>
            <th>Category</th>
            <th>Finished</th>
            <th style="width:220px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < _projects.Count; i++)
        {
            var idx = i;
            var project = _projects[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@project.Title</td>
                <td>@project.Category</td>
                <td>@(project.Finished ? "✓" : "–")</td>
                <td class="d-flex gap-1 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary"
                            title="Move up (reorder)"
                            @onclick="() => MoveUp(idx)"
                            disabled="@(idx == 0)">↑</button>
                    <button class="btn btn-sm btn-outline-secondary"
                            title="Move down (reorder)"
                            @onclick="() => MoveDown(idx)"
                            disabled="@(idx == _projects.Count - 1)">↓</button>
                    <button class="btn btn-sm btn-primary"
                            @onclick="() => Edit(idx)">Edit</button>
                    <button class="btn btn-sm btn-danger"
                            @onclick="() => ConfirmDelete(idx)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_deleteConfirmIndex >= 0)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;">
        <div class="card p-4" style="max-width:440px;margin:10% auto;">
            <h5>Are you sure you want to delete this project?</h5>
            <p class="text-muted">@_projects[_deleteConfirmIndex].Title</p>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-danger" @onclick="DeleteConfirmed">Yes, delete</button>
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProjectInfo> _projects = new();
    private string? _message;
    private int _deleteConfirmIndex = -1;

    protected override void OnInitialized()
    {
        LoadProjects();
    }

    private void LoadProjects()
    {
        _projects = DataService.GetProjects();
    }

    private void CreateNew()
    {
        Nav.NavigateTo("/edit/new");
    }

    private void Edit(int index)
    {
        Nav.NavigateTo($"/edit/{index}");
    }

    private void MoveUp(int index)
    {
        DataService.MoveUp(_projects, index);
        DataService.SaveProjects(_projects);
        _message = "Project moved up.";
    }

    private void MoveDown(int index)
    {
        DataService.MoveDown(_projects, index);
        DataService.SaveProjects(_projects);
        _message = "Project moved down.";
    }

    private void ConfirmDelete(int index)
    {
        _deleteConfirmIndex = index;
    }

    private void DeleteConfirmed()
    {
        var title = _projects[_deleteConfirmIndex].Title;
        _projects.RemoveAt(_deleteConfirmIndex);
        DataService.SaveProjects(_projects);
        _deleteConfirmIndex = -1;
        _message = $"Deleted: {title}";
    }

    private void CancelDelete()
    {
        _deleteConfirmIndex = -1;
    }
}
